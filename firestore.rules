rules_version = '2';
// Who can read and write what in the Study Log's database.
// Deploy with: firebase deploy --only firestore:rules (see README, "Groups and notifications").
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function groupDoc(gid) { return get(/databases/$(database)/documents/groups/$(gid)); }

    // Each person's own notes. Only they can read or write them.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && me() == uid;
    }

    // A person's name, what they share, notification choices and devices.
    // Only they can see it; the notification server reads it with its own access.
    match /people/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Invite codes point to a group. Anyone signed in can look up a code they were given,
    // but nobody can list the codes.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['gid', 'name'])
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.owner == me()
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.code == code;
      allow update: if signedIn()
        && changed().hasOnly(['name'])
        && groupDoc(resource.data.gid).data.owner == me();
      allow delete: if signedIn() && groupDoc(resource.data.gid).data.owner == me();
    }

    match /groups/{gid} {
      function isMember() { return signedIn() && me() in resource.data.members; }
      function isOwner() { return signedIn() && resource.data.owner == me(); }
      function newMembers() { return request.resource.data.members.toSet(); }
      function oldMembers() { return resource.data.members.toSet(); }
      function okName() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      }
      function okWeekly() {
        return !('weekly' in request.resource.data)
          || (request.resource.data.weekly.keys().hasOnly(['week', 'text', 'by', 'name', 'at'])
            && request.resource.data.weekly.text is string
            && request.resource.data.weekly.text.size() <= 80);
      }

      allow get: if isMember();
      // the app asks only for groups it is in: where members array-contains me
      allow list: if signedIn() && me() in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'code', 'createdAt'])
        && request.resource.data.owner == me()
        && request.resource.data.members == [me()]
        && request.resource.data.code is string && request.resource.data.code.size() == 8
        && okName();

      allow update: if
        // whoever started the group: rename, new code, remove people, hand it to someone else
        (isOwner()
          && changed().hasOnly(['name', 'code', 'members', 'owner', 'weekly'])
          && newMembers().difference(oldMembers()).size() == 0
          && request.resource.data.owner in request.resource.data.members
          && request.resource.data.code is string && request.resource.data.code.size() == 8
          && okName() && okWeekly())
        // joining with the group's current code
        || (signedIn() && !(me() in resource.data.members)
          && changed().hasOnly(['members', 'lastJoin'])
          && request.resource.data.lastJoin == resource.data.code
          && newMembers() == oldMembers().union([me()].toSet())
          && request.resource.data.members.size() <= 100)
        // leaving
        || (isMember() && !isOwner()
          && changed().hasOnly(['members'])
          && newMembers() == oldMembers().difference([me()].toSet()))
        // anyone in the group can enter the week's Meeting Workbook reading
        || (isMember()
          && changed().hasOnly(['weekly'])
          && request.resource.data.weekly.by == me()
          && okWeekly());

      allow delete: if isOwner() && resource.data.members.size() <= 1;

      function memberOf() { return signedIn() && me() in groupDoc(gid).data.members; }
      function ownerOf() { return signedIn() && groupDoc(gid).data.owner == me(); }

      // Each person's name and progress, as they choose to share it
      match /members/{uid} {
        allow read: if memberOf();
        allow create, update: if memberOf() && me() == uid
          && request.resource.data.keys().hasOnly(['name', 'color', 'shares', 'streak', 'dtDate', 'bibleDate', 'path', 'read', 'total', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
        allow delete: if signedIn() && (me() == uid || ownerOf());
      }

      // Daily text comments (and Bible reading notes, for people who share them)
      match /posts/{pid} {
        allow read: if memberOf();
        allow create: if memberOf()
          && request.resource.data.uid == me()
          && pid.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + me() + '(_b)?$')
          && request.resource.data.keys().hasOnly(['uid', 'name', 'date', 'kind', 'text', 'ref', 'updatedAt', 'hearts', 'hidden'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && request.resource.data.get('hearts', []).size() == 0
          && request.resource.data.get('hidden', false) == false;
        allow update: if memberOf() && (
          // the writer changes it
          (resource.data.uid == me()
            && changed().hasOnly(['text', 'name', 'ref', 'updatedAt'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 4000)
          // a heart: add or take back your own
          || (changed().hasOnly(['hearts'])
            && request.resource.data.hearts.toSet().difference(resource.data.get('hearts', []).toSet())
                 .union(resource.data.get('hearts', []).toSet().difference(request.resource.data.hearts.toSet()))
                 .hasOnly([me()]))
          // whoever started the group hides it or shows it again
          || (ownerOf() && changed().hasOnly(['hidden']) && request.resource.data.hidden is bool));
        allow delete: if signedIn() && resource.data.uid == me();
      }

      // Replies under a post
      match /replies/{rid} {
        allow read: if memberOf();
        allow create: if memberOf()
          && request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at', 'date', 'postId', 'postUid'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow update: if memberOf() && resource.data.uid == me()
          && changed().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow delete: if signedIn() && (resource.data.uid == me() || ownerOf());
      }
    }
  }
}
